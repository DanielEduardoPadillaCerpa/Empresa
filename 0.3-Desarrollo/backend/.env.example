PORT=8081

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=replace_with_a_secret
DB_NAME=your_database_name
DB_CONNECTION_LIMIT=4
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
TRUST_PROXY_HOPS=1

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=2h
REFRESH_EXPIRES_DIAS=7
CRYPTO_KEY=replace_with_exactly_32_characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_before_first_start

# SMTP is used for receipt emails; MFA codes are delivered by the dedicated n8n workflow.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Use a different random secret per service.
MFA_TOKEN_PEPPER=replace_with_a_different_32_character_random_secret
PAYMENT_MODE=mock
PAYMENT_WEBHOOK_SECRET=replace_with_a_long_random_secret
RECEIPT_LINK_SECRET=replace_with_another_long_random_secret
ADMIN_NOTIFICATION_EMAIL=
RECEIPT_LINK_BASE_URL=http://localhost:8081

# n8n automation; MFA is the only workflow that receives a short-lived OTP.
N8N_CHAT_WEBHOOK_URL=
N8N_API_TOKEN=
N8N_MFA_WEBHOOK_URL=
N8N_MFA_WEBHOOK_SECRET=

# Distinct secrets/tokens per workflow. Webhook URLs must use HTTPS outside localhost.
N8N_W1_PAYMENT_WEBHOOK_URL=
N8N_W1_SECRET=
N8N_W2_DAILY_SUMMARY_TOKEN=
N8N_W3_STOCK_WEBHOOK_URL=
N8N_W3_SECRET=
N8N_W4_EXPIRY_TOKEN=
N8N_W6_ASSISTANT_ESCALATION_WEBHOOK_URL=
N8N_W6_ASSISTANT_ESCALATION_SECRET=
ASSISTANT_WEEKLY_SUMMARY_TOKEN=
ASSISTANT_MODE=rules
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
AUTOMATION_STOCK_LOW_THRESHOLD=5
