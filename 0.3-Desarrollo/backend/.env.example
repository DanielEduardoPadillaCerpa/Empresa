PORT=8081

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=replace_with_a_secret
DB_NAME=your_database_name

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=2h
REFRESH_EXPIRES_DIAS=7
CRYPTO_KEY=replace_with_exactly_32_characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_before_first_start

# Set these to n8n production webhook URLs to enable the integrations.
N8N_CHAT_WEBHOOK_URL=
N8N_PAYMENT_WEBHOOK_URL=
N8N_API_TOKEN=
N8N_PAYMENT_ENVIRONMENT=sandbox
ADMIN_NOTIFICATION_EMAIL=pcerpadaniel@gmail.com
